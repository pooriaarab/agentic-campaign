{
  "name": "agentic-campaign",
  "version": "0.1.1",
  "description": "Social campaign planning, draft approvals, and queue exports for Node.js and TypeScript, with CLI and Model Context Protocol tools.",
  "keywords": [
    "campaign-planning",
    "content-calendar",
    "social-media",
    "draft-approval",
    "queue-export",
    "typescript",
    "nodejs",
    "cli",
    "mcp",
    "model-context-protocol",
    "zod",
    "agentic-publish"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-campaign.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-campaign",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-campaign": "./dist/cli.js",
    "agentic-campaign-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
